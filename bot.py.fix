    def control_loop(self):
        chat_id = env("TELEGRAM_CHAT_ID")
        if not chat_id:
            log("TELEGRAM_CHAT_ID not set; telegram controls disabled")
            return
        offset = None
        try:
            first = telegram_call("getUpdates", {"offset": -1, "timeout": 0}, timeout=15)
            updates = first.get("result") or []
            if updates:
                offset = updates[-1]["update_id"] + 1
        except Exception as exc:
            log(f"telegram command startup failed: {type(exc).__name__}: {exc}")
            return
        while True:
            try:
                params = {"timeout": 25, "allowed_updates": json.dumps(["message"])}
                if offset is not None:
                    params["offset"] = offset
                result = telegram_call("getUpdates", params)
                for update in result.get("result") or []:
                    offset = update["update_id"] + 1
                    self.handle_command(update, chat_id)
            except Exception as exc:
                log(f"telegram command polling failed: {type(exc).__name__}: {exc}")
                time.sleep(10)

    def handle_command(self, update, chat_id):
        message = update.get("message") or {}
        msg_chat_id = str((message.get("chat") or {}).get("id") or "")
        if msg_chat_id != str(chat_id):
            return
        text = (message.get("text") or "").strip()
        if not text:
            return
        parts = text.split()
        command = parts[0].split("@")[0].lower()
        args = parts[1:]
        reply = self.command_reply(command, args)
        if reply:
            log(f"telegram command {command}")
            notify(reply)
        else:
            log(f"telegram unknown command {command}")
